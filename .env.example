# Copy to .env for local development. On Hugging Face Spaces, set these
# under Settings > Variables and secrets instead -- never commit real keys.

# Required for the AI pipeline (clarification, findings, review
# correlation, corrective actions) to run at all.
# Get a free key at https://console.groq.com/keys
OpenAI_API_KEY=add OpenAI API key

# Optional. If unset, the app automatically runs in MOCK REVIEW mode --
# fully demoable end-to-end, but review data is clearly-labeled synthetic
# sample data rather than live Wolf Creek Golf Club reviews.
GOOGLE_MAPS_API_KEY= add Maps API key

# Optional model overrides (defaults shown, both Groq-hosted). See
# backend/agents.py for how these are used -- fast model for
# classification-style steps, strong model for judgment-heavy steps.
BROADPEAK_MODEL_FAST=llama-3.1-8b-instant
BROADPEAK_MODEL_STRONG=llama-3.3-70b-versatile

# Internal-only; you shouldn't need to change these.
BACKEND_PORT=8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
